# User unit for the dsh-rc page and push notification server. Install:
#   cp examples/dsh-rc.service ~/.config/systemd/user/ && edit the paths below
#   systemctl --user daemon-reload && systemctl --user enable --now dsh-rc
[Unit]
Description=dsh-rc phone UI and push notification server
After=network-online.target

[Service]
WorkingDirectory=%h/dsh-rc
# Replace the node path below with your own (`which node`); for nvm that is
# usually %h/.nvm/versions/node/<version>/bin/node.
ExecStart=/usr/bin/node %h/dsh-rc/server/index.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
